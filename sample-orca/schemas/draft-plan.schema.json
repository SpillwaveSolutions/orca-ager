{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "draft-plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "summary",
    "steps"
  ],
  "properties": {
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
