{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "plan-critique",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "author",
    "findings",
    "score"
  ],
  "properties": {
    "author": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "score": {
      "type": "number"
    }
  }
}
